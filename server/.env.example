# MongoDB connection string (Atlas or local)
MONGODB_URI=your_mongodb_connection_string

# Contact-form email notifications (Gmail SMTP via nodemailer)
# GMAIL_USER: the Gmail address that sends and receives the notifications
# GMAIL_APP_PASSWORD: a 16-character Google App Password — NOT your Gmail password.
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
